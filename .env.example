# ==============================================================================
# Shnik - Environment Variables
# All services below are 100% FREE (No credit card required)
# ==============================================================================

# 1. Supabase (100% Free at https://supabase.com)
# Create a free project -> Settings -> API -> Copy Project URL & Keys:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Security & Gateway Token (Optional secret token)
QUSEC_TOKEN=shnik_secure_gateway_token_prod

# 3. Mode Toggle:
# Set to 'false' when using live Supabase backend.
# Set to 'true' to demo locally without backend keys.
NEXT_PUBLIC_MOCK=false
